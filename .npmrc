; Make the engines field in package.json a requirement rather than a warning.
;
; Without this, npm prints a notice about an unsupported Node version and
; installs anyway — so a version mismatch surfaces later as a confusing build
; or runtime error instead of at the moment it could be fixed. This repo is
; meant to be cloned and run by people who did not write it, and "you need Node
; 20 or 22" is a far better first failure than a stack trace from a transitive
; dependency.
engine-strict=true

; Exact versions when adding a dependency, rather than a caret range.
;
; A caret lets `npm install` quietly float a package to whatever is newest that
; morning. That is how @types/node reached v26 in a project that runs Node 22:
; nothing asked for it, a transitive "*" range simply resolved to the newest
; release. Exact saves reduce the lockfile to the single source of truth it is
; supposed to be.
save-exact=true
